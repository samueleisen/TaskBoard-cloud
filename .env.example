# ============================================================
# TaskBoard Cloud — Environment Configuration Template
# ============================================================

# Application Environment (development | staging | production)
NODE_ENV=development
PORT=8080

# Application URL
APP_URL=http://localhost:8080

# Database Configuration (PostgreSQL)
# If left empty, the server automatically boots in 'local-memory' mode
# with sample data, waiting for your GCP Cloud SQL or local Postgres connection!
DATABASE_URL=postgresql://taskboard:taskboard_secret@localhost:5432/taskboard_dev

# Authentication & Security
JWT_SECRET=super-secret-taskboard-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Email Reminder Service (Resend or SendGrid)
# Optional in development; reminder logs will be printed to stdout
RESEND_API_KEY=re_sample_key_123456789
EMAIL_FROM=TaskBoard Alerts <alerts@taskboard.app>

# Cloud Run / Internal Job Secret
# Used by Cloud Scheduler to trigger /api/v1/jobs/send-reminders
CRON_SECRET=internal-cron-secret-token-for-reminders
